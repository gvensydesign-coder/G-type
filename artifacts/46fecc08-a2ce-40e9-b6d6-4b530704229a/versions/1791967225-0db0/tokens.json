{
  "name": "Подхват",
  "version": "20.0.0",
  "platform": "iOS primary · web prototype",
  "color": {
    "brand": {
      "ink": "#17191B",
      "paper": "#F3F4F2",
      "white": "#FFFFFF",
      "lime": "#DBF95B",
      "limeStrong": "#CBEA39",
      "air": "#658592",
      "airDark": "#263D4A",
      "airSurface": "#DBE5E9"
    },
    "status": {
      "success": "#267349",
      "warning": "#946300",
      "danger": "#B33040",
      "info": "#235EAD"
    },
    "light": {
      "app-bg": "#F8F9F7",
      "app-text": "#17191B",
      "card-bg": "#FFFFFF",
      "secondary": "#556166",
      "secondary-bg": "#E7ECE8",
      "badge-bg": "#E4E8E6",
      "app-border": "#E7EAE6",
      "input-border": "#AAB4B6",
      "error-text": "#B33040",
      "focus": "#235EAD",
      "field-fill": "#ECEEE9",
      "nav-idle": "#8A969A",
      "nav-label": "#667277",
      "nav-active": "#17191B",
      "nav-fill": "rgba(243,245,242,.78)",
      "send": "#DBF95B",
      "mesh-lime": "#F2F9D9",
      "mesh-aqua": "#E9F3F6",
      "mesh-lilac": "#F3EFF8"
    },
    "dark": {
      "app-bg": "#0E1011",
      "app-text": "#FFFFFF",
      "card-bg": "#1A1D1F",
      "secondary": "#BAC4C7",
      "secondary-bg": "#31393D",
      "badge-bg": "#31393D",
      "app-border": "#41484C",
      "input-border": "#69747B",
      "error-text": "#FF9AA9",
      "focus": "#DBF95B",
      "field-fill": "#23272A",
      "nav-fill": "rgba(26,29,31,.8)"
    }
  },
  "type": {
    "family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif",
    "display": {
      "size": 34,
      "lineHeight": 38,
      "weight": 400,
      "letterSpacing": -0.8
    },
    "heading": {
      "size": 30,
      "lineHeight": 34,
      "weight": 400,
      "letterSpacing": -0.7
    },
    "title": {
      "size": 18,
      "lineHeight": 24,
      "weight": 600
    },
    "body": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400
    },
    "bodyLarge": {
      "size": 16,
      "lineHeight": 24,
      "weight": 400
    },
    "label": {
      "size": 14,
      "lineHeight": 20,
      "weight": 600
    },
    "caption": {
      "size": 12,
      "lineHeight": 18,
      "weight": 400
    },
    "micro": {
      "size": 10,
      "lineHeight": 14,
      "weight": 400
    }
  },
  "space": {
    "page-inset": 10,
    "control-inset": 10,
    "surface-inset": 18,
    "section-gap": 12,
    "scale": [
      4,
      6,
      8,
      10,
      12,
      16,
      18,
      20
    ]
  },
  "size": {
    "action-primary": 56,
    "action": 54,
    "action-compact": 44,
    "tag": 40,
    "circle": 54,
    "tap-min": 44,
    "icon": 24
  },
  "radius": {
    "pill": 999,
    "circle": "50%",
    "card": 28,
    "control": 24,
    "photo-in-card": 22,
    "tile": 20,
    "cover": 18,
    "icon-tile": 16,
    "checkbox": 8
  },
  "motion": {
    "press": {
      "duration": 120,
      "scale": 0.92
    },
    "page": {
      "duration": 380,
      "easing": "cubic-bezier(.22,.7,.2,1)"
    },
    "control": {
      "duration": 160
    },
    "reduce": "transform and shimmer off"
  },
  "glass": {
    "use": "navigation, header, composer only",
    "blur": 24,
    "reduceTransparency": "blur off, opaque fill"
  },
  "v13": {
    "outlines": "none on controls and cards; fill-based fields; checkbox/radio keep a thin border",
    "shadows": "soft only; none in dark",
    "glass": "cards and dock only; opaque fallback",
    "radius": {
      "card": 32,
      "well": 28,
      "mini": 28,
      "pill": 999
    },
    "sizes": {
      "dock": 76,
      "dock-button": 56,
      "header-circle": 44,
      "thumb": 58,
      "mini": 56,
      "avatar": 84,
      "mini-action": 48
    }
  },
  "v14": {
    "focus": {
      "ring": "3px",
      "line": "1.5px"
    },
    "textScale": [
      1,
      1.15,
      1.3
    ],
    "qr": {
      "ecc": "L",
      "versions": "1-5"
    },
    "map": {
      "light": "Podhvat/assets/map-light.svg",
      "dark": "Podhvat/assets/map-dark.svg"
    }
  },
  "v20": {
    "mascot": {
      "shadow-light": "drop-shadow(0 14px 16px rgba(30,45,52,.30)) drop-shadow(0 3px 4px rgba(30,45,52,.16))",
      "shadow-dark": "drop-shadow(0 12px 16px rgba(0,0,0,.55)) drop-shadow(0 2px 3px rgba(0,0,0,.35))",
      "fade-bottom": "linear-gradient(to bottom,#000 64%,transparent 76.5%)",
      "canvas-scale": "180% блока 188 px (по 40% запаса с каждой стороны), центр совпадает с блоком",
      "size": "min(46vw,188px)"
    },
    "hearts": {
      "fill": "--lime #DBF95B",
      "fill-deep": "--limeStrong #CBEA39",
      "stroke": "--ink #17191B, 1.7 px",
      "count": "6–8",
      "max-live": 28,
      "size": "14–27 px",
      "rise": "90–150 px",
      "duration": "1.1–1.7 s",
      "stagger": "70 ms"
    },
    "chatOptions": {
      "bg": "--airSurface",
      "border": "--air",
      "text": "--airDark",
      "pressed": "--lime",
      "caption": "Выберите ответ",
      "darkBg": "rgba(101,133,146,.30)",
      "darkBorder": "#8CA9B5"
    },
    "device": {
      "model": "iPhone 17 Pro",
      "screen": [
        402,
        874
      ],
      "screenRadius": 55,
      "island": [
        126,
        37
      ],
      "bezel": 12,
      "homeIndicator": [
        134,
        5
      ],
      "topSafe": 60
    }
  },
  "v21": {
    "dock": {
      "items": 5,
      "hero": {
        "size": 64,
        "lift": 10,
        "target": "home"
      }
    },
    "button": {
      "edge": "#E8FF7E",
      "core": "#BFE02B",
      "rim": "rgba(255,255,255,.85)",
      "pressed": "translateY(1px) scale(.985)"
    },
    "liveBackground": {
      "layers": 2,
      "durations": [
        26,
        34
      ]
    },
    "chat": {
      "avatar": 32,
      "userMaxWidth": "78%"
    }
  }
}